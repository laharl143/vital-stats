# Postgres connection strings (Prisma)
DATABASE_URL=
DIRECT_URL=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Resend (transactional email)
RESEND_API_KEY=
# Verified Resend sender, e.g. "VitalStats <notifications@vitalstats.com>"
RESEND_FROM_EMAIL=
# Comma-separated emails to notify on new consult/inquiry submissions.
# Falls back to all ADMIN/SUPER_ADMIN users in the DB if unset.
ADMIN_NOTIFICATION_EMAILS=

# Cloudinary (product image uploads/delivery)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudinary cloud name, exposed to the browser for next-cloudinary's
# client components (CldImage/CldVideoPlayer). Not a secret — same
# value as CLOUDINARY_CLOUD_NAME above.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Unsigned upload preset (Cloudinary dashboard), scoped to a "doctor-notes"
# folder — used by CldUploadWidget for Doctor's Notes photo uploads.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Google Apps Script endpoint that POST /api/submit-form forwards a
# sanitized copy of each book-consult intake to (optional — the forward is
# skipped entirely when unset).
APPS_SCRIPT_FORM_URL=

# OMS (order management system) that an admin's Confirm hands each order to.
# Base URL of its API, e.g. https://ed-oms.vercel.app/api/v1 (no trailing slash needed).
OMS_BASE_URL=
# Bearer API key for the OMS. A secret: set it in Vercel/.env, never commit it.
OMS_API_KEY=
# Shared secret that verifies the OMS status webhook (POST /api/oms/webhook). A secret: never commit it.
OMS_WEBHOOK_SIGNING_SECRET=

# PayMongo online payment (spec 0004). The secret key (sk_test_... locally, sk_live_... in production)
# creates checkout sessions and refunds, and picks which webhook signature (te or li) is checked.
# Without it, "Card or e wallet" shows as unavailable. A secret: never commit it.
PAYMONGO_SECRET_KEY=
# Signing secret PayMongo returns when you register the webhook for /api/paymongo/webhook
# (event checkout_session.payment.paid). A secret: never commit it.
PAYMONGO_WEBHOOK_SECRET=
