# Postgres connection strings (Prisma)
DATABASE_URL=
DIRECT_URL=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Resend (transactional email)
RESEND_API_KEY=
# Verified Resend sender, e.g. "VitalStats <notifications@vitalstats.com>"
RESEND_FROM_EMAIL=
# Comma-separated emails to notify on new consult/inquiry submissions.
# Falls back to all ADMIN/SUPER_ADMIN users in the DB if unset.
ADMIN_NOTIFICATION_EMAILS=

# Cloudinary (product image uploads/delivery)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudinary cloud name, exposed to the browser for next-cloudinary's
# client components (CldImage/CldVideoPlayer). Not a secret — same
# value as CLOUDINARY_CLOUD_NAME above.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Unsigned upload preset (Cloudinary dashboard), scoped to a "doctor-notes"
# folder — used by CldUploadWidget for Doctor's Notes photo uploads.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Google Apps Script endpoint that POST /api/submit-form forwards a
# sanitized copy of each book-consult intake to (optional — the forward is
# skipped entirely when unset).
APPS_SCRIPT_FORM_URL=
