// ============================================================
// VitalStats — Prisma Schema
// Database: PostgreSQL
// ORM: Prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Category {
  WEIGHT_MANAGEMENT
  RECOVERY_ANTI_AGING
  SKIN_CARE
  MEDICAL_CONSULTATION
}

enum DeliveryMethod {
  INJECTION // e.g. Tirzepatide, NAD+, GHK-Cu
  TOPICAL // e.g. Luméla soap, lotion, serum
  ORAL // future-proofing
  CONSULTATION // service, not a physical product
}

enum InquiryType {
  PRODUCT_AVAILABILITY
  PROGRAM_GUIDANCE
  ORDER_INQUIRY
  GENERAL
}

enum InquiryStatus {
  NEW
  READ
  RESPONDED
  CLOSED
}

enum OrderStatus {
  PENDING // inquiry received, not yet confirmed
  CONFIRMED // admin confirmed availability
  PROCESSING // being prepared
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  AWAITING_PAYMENT // online order saved, customer sent to PayMongo, not paid yet (spec 0004)
}

// The money side of an online order (spec 0004). Null for COD and admin orders.
enum PaymentStatus {
  UNPAID
  PAID
  REFUND_NEEDED // paid, but the OMS refused or cancelled the order
  REFUNDED
  EXPIRED // abandoned, cancelled by the customer, or the session could not be created
}

enum OrderSource {
  ADMIN // created by staff in the admin orders page
  STOREFRONT // placed by the customer at /checkout (VS-254)
}

enum PaymentMethod {
  COD
  PREPAID
}

// ─────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────

model Product {
  id                   String         @id @default(cuid())
  slug                 String         @unique // URL-friendly: "tirzepatide", "nad-plus"
  name                 String
  tagline              String? // short hook, e.g. "Once-a-week weight loss injection"
  description          String // main body text (markdown supported)
  howItWorks           String? // mechanism / science section
  howAdministered      String? // injection site info, dosage notes
  warnings             String? // ⚠️ medical supervision notices
  category             Category
  deliveryMethod       DeliveryMethod
  price                Decimal?       @db.Decimal(10, 2) // null for consultation / injectable (price on inquiry)
  currency             String         @default("PHP")
  isBestSeller         Boolean        @default(false)
  isFdaApproved        Boolean        @default(false)
  isClinicallyGuided   Boolean        @default(false)
  requiresPrescription Boolean        @default(false)
  isActive             Boolean        @default(true)
  sortOrder            Int            @default(0)

  images      ProductImage[]
  videos      ProductVideo[]
  ingredients ProductIngredient[]
  benefits    ProductBenefit[]
  orderItems  OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String // Cloudinary URL
  publicId  String // Cloudinary public_id (for deletion)
  alt       String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVideo {
  id        String  @id @default(cuid())
  productId String
  publicId  String // Cloudinary public_id for the video asset
  title     String? // e.g. "Self Administration Tutorial"
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductIngredient {
  id        String  @id @default(cuid())
  productId String
  name      String // e.g. "Kojic Acid", "Niacinamide", "5x Ceramides"
  role      String? // what it does, one line

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductBenefit {
  id        String @id @default(cuid())
  productId String
  benefit   String // e.g. "Make you feel full faster"
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// INQUIRY (contact form)
// ─────────────────────────────────────────

model Inquiry {
  id          String        @id @default(cuid())
  name        String
  contactInfo String // phone or Facebook name / messenger link
  message     String
  type        InquiryType   @default(GENERAL)
  status      InquiryStatus @default(NEW)
  adminNotes  String? // internal notes from the VitalStats team
  productId   String? // optional: which product they're asking about
  ipAddress   String? // for spam detection

  // Privacy consent (spec 0001), stamped by the server; null on rows saved before it.
  privacyVersion String?
  consentedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([ipAddress, createdAt])
}

// ─────────────────────────────────────────
// ORDER
// ─────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique @default(cuid()) // human-readable ref
  customerName    String
  customerContact String // phone or messenger
  customerAddress String?
  status          OrderStatus @default(PENDING)
  notes           String? // special instructions
  adminNotes      String?
  totalAmount     Decimal?    @db.Decimal(10, 2)
  currency        String      @default("PHP")

  // Set together, only after both OMS calls succeed (VS-243).
  omsCustomerId String?
  omsOrderId    String?
  sentToOmsAt   DateTime?
  // occurredAt of the last OMS status event applied (VS-242); older events are ignored.
  omsLastEventAt DateTime?

  // Storefront checkout (VS-254, spec 0003). Admin orders keep the defaults and nulls.
  source         OrderSource    @default(ADMIN)
  paymentMethod  PaymentMethod? // null: staff pick it at confirm
  customerEmail  String?
  shippingFee    Decimal        @default(0) @db.Decimal(10, 2) // included in totalAmount
  stockUnchecked Boolean        @default(false) // the OMS was unreachable at submit
  checkoutKey    String?        @unique // the browser's retry key; one order per key
  ipAddress      String? // for the checkout rate limit
  privacyVersion String?
  termsVersion   String?
  consentedAt    DateTime?

  // Online payment through PayMongo (VS-255, spec 0004). Only the signed webhook sets PAID.
  paymentStatus       PaymentStatus?
  paymentExpiresAt    DateTime?
  paymongoCheckoutId  String?        @unique // cs_…, the webhook finds the order by this
  paymongoCheckoutUrl String? // replayed on a repeat submit
  paymongoPaymentId   String?        @unique // pay_…, sent to the OMS as payment.reference
  paymentChannel      String? // card, gcash, maya, grab_pay, qrph, dob, unknown
  paidAt              DateTime?
  paidAmount          Decimal?       @db.Decimal(10, 2)
  omsSendError        String? // last plain OMS send failure, cleared on success
  refundId            String? // ref_…, null after a manual refund
  refundedAt          DateTime?

  // Order status page and customer emails (VS-256, spec 0005). Storefront orders only.
  statusToken String? @unique // the secret in /orders/<token>, 32 random bytes base64url

  items          OrderItem[]
  customerEmails CustomerEmail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([ipAddress, createdAt])
  @@index([status, paymentExpiresAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String // snapshot at order time (in case product is later renamed)
  quantity    Int      @default(1)
  unitPrice   Decimal? @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// One row per customer email, claimed before sending (VS-256, spec 0005). The unique
// (orderId, kind) is what makes each email go out at most once, whatever retries the webhooks do.
enum CustomerEmailKind {
  RECEIVED
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model CustomerEmail {
  id        String            @id @default(cuid())
  orderId   String
  kind      CustomerEmailKind
  createdAt DateTime          @default(now()) // the claim
  sentAt    DateTime?
  failedAt  DateTime?
  error     String? // a short code, never a provider body

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind])
}

// One row per OMS webhook event already handled (VS-242). The unique eventId
// is what makes a redelivered event a no-op.
model OmsWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  type      String // "order.status_changed" | "shipment.updated"
  handledAt DateTime @default(now())
}

// ─────────────────────────────────────────
// ADMIN USER (NextAuth)
// ─────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           Role      @default(ADMIN)

  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────
// MEDICAL HISTORY (book-consult form)
// ─────────────────────────────────────────

model MedicalHistory {
  id String @id @default(cuid())

  // Demographics
  fullName           String
  dateOfBirth        String // stored as MM/DD/YYYY string
  gender             String
  phone              String?
  email              String?
  height             String? // in cm
  weight             String? // in kg
  waistCircumference String?
  smokingStatus      String?
  drinkingFrequency  String?

  // BMI
  bmi         String?
  bmiCategory String?

  // Medical History
  mtc          String // Yes / No
  pancreatitis String
  gallbladder  String
  gi           String
  diabetes     String
  pregnant     String
  surgeries    String?
  medications  String?
  allergies    String?

  // Consent
  consent1 Boolean @default(false)
  consent2 Boolean @default(false)
  consent3 Boolean @default(false)
  // Privacy and health data consent (spec 0001), stamped by the server; null on rows saved before it.
  privacyVersion String?
  consentedAt    DateTime?

  // Meta
  status     MedicalHistoryStatus @default(NEW)
  adminNotes String?
  ipAddress  String?
  sequence   Int                  @unique @default(autoincrement())

  doctorNotes DoctorNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([ipAddress, createdAt])
}

enum MedicalHistoryStatus {
  NEW
  REVIEWED
  CONTACTED
  CLOSED
}

// ─────────────────────────────────────────
// DOCTOR NOTES (attached to a MedicalHistory record)
// ─────────────────────────────────────────

enum DoctorNoteType {
  TEXT
  PHOTO
}

model DoctorNote {
  id               String         @id @default(cuid())
  medicalHistoryId String
  type             DoctorNoteType
  content          String? // typed note body (TEXT notes)
  imageUrl         String? // Cloudinary secure_url (PHOTO notes)
  publicId         String? // Cloudinary public_id (PHOTO notes)

  medicalHistory MedicalHistory @relation(fields: [medicalHistoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([medicalHistoryId])
}
